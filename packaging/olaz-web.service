[Unit]
Description=Olaz Web — Zero-Server-Persistence Stateless Zalo Relay
Documentation=https://github.com/vndangkhoa/zalo-swift-re
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/olaz-web --listen 127.0.0.1:8080 --asar /opt/olaz/app.asar
Environment=RUST_LOG=info
# Optional shared token gate: load OLAZ_WEB_TOKEN=... from a root-owned 0400 file
EnvironmentFile=-/etc/olaz/olaz-web.env

# Zero-Persistence & Ephemeral User Sandboxing
DynamicUser=yes
ReadOnlyPaths=/
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes

# Memory & Core Dump Hardening (ensure ephemeral relay buffers never hit swap or core dumps)
LimitCORE=0
MemorySwapMax=0

# Kernel & Capability Lockdown
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6

Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- JavaScriptCore only JITs with this entitlement on macOS 27; without it the
         JS modules (libsignal's asm.js Curve25519) run ~15-25x slower in the interpreter. -->
    <key>com.apple.security.cs.allow-jit</key><true/>
    <!-- Calls: ZaloCall (started by this app) captures audio / video. These only matter if the app is ever
         signed with the hardened runtime; ad-hoc builds are not sandboxed and prompt via the Info.plist texts. -->
    <key>com.apple.security.device.audio-input</key><true/>
    <key>com.apple.security.device.camera</key><true/>
</dict>
</plist>
